{
  "primitives": {"paper": "#ffffff", "ink": "#182230"},
  "themes": {
    "light": {"surface": "{paper}", "text": "{ink}", "accent": "#174c80", "on-accent": "#ffffff", "outline": "#536477"},
    "dark": {"surface": "#182230", "text": "#f5f7fa", "accent": "#acd4fb", "on-accent": "#142334", "outline": "#a2afbe"}
  },
  "pairs": [
    {"fg": "text", "bg": "surface", "use": "text"},
    {"fg": "on-accent", "bg": "accent", "use": "text"},
    {"fg": "outline", "bg": "surface", "use": "nontext"}
  ],
  "space": {"small": 8, "medium": 16, "large": 24},
  "radius": {"control": 6},
  "type": {"body": {"family": "system-ui, sans-serif", "size": 16, "line": 1.5, "weight": 400}}
}
